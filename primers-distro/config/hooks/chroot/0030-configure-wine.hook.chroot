#!/bin/bash
# PRIMERS OS - Windows application support
# Wine itself comes from primers.list.chroot. Each user's Wine prefix is
# created automatically the first time primers-compat runs.
set -euo pipefail

# Open .exe / .msi files with primers-compat by default
install -d /etc/xdg
cat > /etc/xdg/mimeapps.list <<'EOF'
[Default Applications]
application/x-ms-dos-executable=primers-compat.desktop
application/x-msdos-program=primers-compat.desktop
application/x-msdownload=primers-compat.desktop
application/x-msi=primers-compat.desktop
application/x-ms-shortcut=primers-compat.desktop
EOF

update-desktop-database -q /usr/share/applications 2>/dev/null || true
