#!/bin/bash
# PRIMERS OS — bootloader defaults and CPU governor for installed systems
set -euo pipefail

# Boot menu (docs/benchmarks.md): no wait on a PC with only PRIMERS OS (hold
# Shift or press Esc for the menu). With another system on the disk, Ubuntu's
# os-prober script shows the menu for 10 s anyway; after an interrupted boot
# the menu shows for 10 s (Ubuntu's default is 30).
# Kernel command line for installed systems. CPU vulnerability mitigations
# stay ON (the kernel default): turning them off exposes every user to
# Spectre/Meltdown-class attacks for a few percent of speed.
cat > /etc/default/grub <<'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=0
GRUB_RECORDFAIL_TIMEOUT=10
GRUB_DISTRIBUTOR="PRIMERS OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash threadirqs"
GRUB_CMDLINE_LINUX=""
GRUB_THEME="/usr/share/grub/themes/primers/theme.txt"
GRUB_GFXMODE="1920x1080,1280x720,auto"
GRUB_DISABLE_OS_PROBER=false
EOF

# Performance CPU governor while on mains power; the kernel default
# (powersave/schedutil) is kept on battery so laptops don't drain.
install -d /usr/lib/primers
cat > /usr/lib/primers/perf-governor <<'EOF'
#!/bin/sh
on_ac=1
for ps in /sys/class/power_supply/*; do
  [ -r "$ps/type" ] || continue
  if [ "$(cat "$ps/type")" = "Mains" ]; then
    on_ac="$(cat "$ps/online" 2>/dev/null || echo 1)"
    break
  fi
done
[ "$on_ac" = "1" ] || exit 0
for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  [ -w "$f" ] && echo performance > "$f" 2>/dev/null || true
done
exit 0
EOF
chmod 0755 /usr/lib/primers/perf-governor

cat > /etc/systemd/system/primers-perf.service <<'EOF'
[Unit]
Description=PRIMERS OS CPU performance governor (on AC power)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/primers/perf-governor
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# Data Saver: background downloads wait for unmetered networks
# (drop-ins for apt-daily, apt-daily-upgrade and fwupd-refresh ship in overlays)
chmod 0755 /usr/lib/primers/unmetered-network

systemctl enable primers-perf.service

# Services a lab PC doesn't use, started at every boot and competing for the
# disk (docs/benchmarks.md). The packages stay; blueman's and Avahi's start
# on demand over D-Bus if something asks for them.
#   winbind              Samba domain logins (installed for Wine's ntlm_auth only)
#   networkd-dispatcher  hooks for systemd-networkd; PRIMERS OS uses NetworkManager
#   avahi-daemon         mDNS/DNS-SD announcements on the LAN
#   blueman-mechanism    Bluetooth manager's helper (D-Bus activated when used)
#   ubuntu-advantage, ua-reboot-cmds   Ubuntu Pro attachment
#   apport               crash reports (also off for privacy)
for unit in winbind networkd-dispatcher avahi-daemon blueman-mechanism ubuntu-advantage ua-reboot-cmds; do
  systemctl disable "$unit.service" 2>/dev/null || true
done
systemctl disable apport.service 2>/dev/null || true
[ -f /etc/default/apport ] && sed -i 's/^enabled=.*/enabled=0/' /etc/default/apport
for unit in winbind networkd-dispatcher avahi-daemon blueman-mechanism ubuntu-advantage ua-reboot-cmds; do
  if systemctl is-enabled "$unit.service" 2>/dev/null | grep -qx enabled; then
    echo "E: $unit.service is still enabled at boot" >&2; exit 1
  fi
done
systemctl enable zramswap.service 2>/dev/null || true

# A small system journal: less to open and write at boot (docs/benchmarks.md)
chmod 0644 /etc/systemd/journald.conf.d/80-primers-journal-size.conf
grep -qx 'SystemMaxUse=200M' /etc/systemd/journald.conf.d/80-primers-journal-size.conf \
  || { echo "E: the journal's size cap is missing" >&2; exit 1; }

# The login screen doesn't wait for the network (docs/benchmarks.md): LightDM
# starts after systemd-user-sessions.service, which Ubuntu orders after
# network.target for network logins (NIS, LDAP, NFS homes) that PRIMERS OS
# doesn't use, and NetworkManager takes seconds to start on a hard disk. An
# ordering can't be removed with a drop-in, so /etc gets a copy of the unit
# without it; the build stops if Ubuntu's unit changes. During an exam the
# exam firewall is in place before any interface comes up
# (primers-exam-firewall.service, hook 0090); Lab Mode's wipe still comes
# before the login screen (primers-lab-reset.service is ordered before
# systemd-user-sessions.service).
vendor=/lib/systemd/system/systemd-user-sessions.service
expected='After=remote-fs.target nss-user-lookup.target network.target home.mount'
grep -qx "$expected" "$vendor" && [ "$(grep -c '^After=' "$vendor")" -eq 1 ] \
  || { echo "E: Ubuntu's systemd-user-sessions.service changed: check the login screen's ordering" >&2; exit 1; }
{
  echo "# PRIMERS OS: Ubuntu's $vendor without 'network.target' in After="
  echo "# (hook 0060-performance-kernel: the login screen doesn't wait for the network)."
  sed "s|^$expected\$|After=remote-fs.target nss-user-lookup.target home.mount|" "$vendor"
} > /etc/systemd/system/systemd-user-sessions.service
chmod 0644 /etc/systemd/system/systemd-user-sessions.service
grep -qx 'After=remote-fs.target nss-user-lookup.target home.mount' /etc/systemd/system/systemd-user-sessions.service \
  && grep -q '^ExecStart=/lib/systemd/systemd-user-sessions start$' /etc/systemd/system/systemd-user-sessions.service \
  || { echo "E: the systemd-user-sessions.service copy is wrong" >&2; exit 1; }
grep -q '^Before=systemd-user-sessions.service display-manager.service$' /etc/systemd/system/primers-lab-reset.service \
  || { echo "E: Lab Mode's wipe must come before the login screen" >&2; exit 1; }
