#!/bin/bash
# PRIMERS OS — desktop look & feel, artwork, display manager
set -euo pipefail

install -d /usr/share/primers /usr/share/pixmaps

# ── Plymouth boot splash: copy the generic spinner graphics into our theme ──
PLY=/usr/share/plymouth/themes/primers
rm -rf "$PLY"
install -d "$PLY"
cp /usr/share/plymouth/themes/spinner/*.png "$PLY/"
cat > "$PLY/primers.plymouth" <<'PLYEOF'
[Plymouth Theme]
Name=PRIMERS OS
Description=PRIMERS OS boot splash (spinner, firmware logo when available)
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/primers
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.7
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.94
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0a0a0f
BackgroundEndColor=0x0a0a0f
ProgressBarBackgroundColor=0x1e1e3a
ProgressBarForegroundColor=0x00e5ff
DialogClearsFirmwareBackground=false
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=true

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=true

[reboot]
UseEndAnimation=false
UseFirmwareBackground=true

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates…
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading PRIMERS OS…
SubTitle=Do not turn off your computer
PLYEOF

# ── Artwork (wallpaper, logo, icons) generated with Pillow ──
python3 - <<'PYEOF'
import math, os
from PIL import Image, ImageDraw, ImageFilter, ImageFont

BG = (10, 10, 15)
ACCENT = (0, 229, 255)
TEXT = (200, 200, 232)

def font(size, bold=False):
    names = ["NotoSans-Bold.ttf" if bold else "NotoSans-Regular.ttf", "DejaVuSans.ttf"]
    for root, _, files in os.walk("/usr/share/fonts"):
        for n in names:
            if n in files:
                return ImageFont.truetype(os.path.join(root, n), size)
    return ImageFont.load_default()

def mark(size, color=ACCENT, glow=True):
    """The PRIMERS mark: a 'P' monogram inside a hexagon, crossed by one orbit."""
    s = size * 4                                   # supersample for smooth edges
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    c = s / 2
    w = max(4, round(s * 0.045))
    r = s * 0.44
    pts = [(c + r * math.cos(math.radians(a)), c + r * math.sin(math.radians(a)))
           for a in range(-90, 270, 60)]
    d.line(pts + pts[:2], fill=color + (255,), width=w, joint="curve")
    stem_l, stem_r = s * 0.36, s * 0.36 + w * 1.4
    d.rectangle([stem_l, s * 0.27, stem_r, s * 0.73], fill=color + (255,))
    d.rounded_rectangle([stem_l, s * 0.27, s * 0.66, s * 0.53], radius=s * 0.13,
                        outline=color + (255,), width=round(w * 1.4))
    orbit = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    od = ImageDraw.Draw(orbit)
    od.ellipse([s * 0.06, s * 0.40, s * 0.94, s * 0.60], outline=color + (170,), width=max(2, w // 2))
    er = w * 0.95
    od.ellipse([s * 0.94 - er, s * 0.50 - er, s * 0.94 + er, s * 0.50 + er], fill=color + (255,))
    img = Image.alpha_composite(img, orbit.rotate(28, resample=Image.BICUBIC, center=(c, c)))
    img = img.resize((size, size), Image.LANCZOS)
    if glow:
        halo = img.filter(ImageFilter.GaussianBlur(size / 30))
        img = Image.alpha_composite(halo, img)
    return img

def wallpaper(w, h, path):
    img = Image.new("RGB", (w, h), BG)
    d = ImageDraw.Draw(img)
    step = max(40, w // 24)
    for x in range(0, w, step):
        d.line([(x, 0), (x, h)], fill=(18, 18, 30), width=1)
    for y in range(0, h, step):
        d.line([(0, y), (w, y)], fill=(18, 18, 30), width=1)
    logo = mark(int(h * 0.28))
    img.paste(logo, ((w - logo.width) // 2, int(h * 0.26)), logo)
    title = "PRIMERS OS"
    f = font(int(h * 0.055), bold=True)
    tw = d.textlength(title, font=f)
    d.text(((w - tw) / 2, h * 0.58), title, font=f, fill=TEXT)
    sub = "AI-native · Genesis"
    f2 = font(int(h * 0.022))
    sw = d.textlength(sub, font=f2)
    d.text(((w - sw) / 2, h * 0.66), sub, font=f2, fill=(96, 96, 128))
    img.save(path, optimize=True)

wallpaper(1920, 1080, "/usr/share/primers/wallpaper.png")
mark(256).save("/usr/share/primers/logo.png")
for px in (16, 32, 48, 64, 128, 256):
    d = f"/usr/share/icons/hicolor/{px}x{px}/apps"
    os.makedirs(d, exist_ok=True)
    mark(px, glow=px >= 48).save(f"{d}/primers.png")
mark(64).save("/usr/share/pixmaps/primers.png")

# GRUB theme artwork (background + terminal box frame)
gdir = "/usr/share/grub/themes/primers"
if os.path.isdir(gdir):
    gb = Image.new("RGB", (1280, 800), BG)
    dg = ImageDraw.Draw(gb)
    for x in range(0, 1280, 64):
        dg.line([(x, 0), (x, 800)], fill=(18, 18, 30), width=1)
    for y in range(0, 800, 64):
        dg.line([(0, y), (1280, y)], fill=(18, 18, 30), width=1)
    logo = mark(150)
    gb.paste(logo, ((1280 - 150) // 2, 70), logo)
    gb.save(f"{gdir}/background.png", optimize=True)
    for part in ("c", "n", "s", "e", "w", "ne", "nw", "se", "sw"):
        colour = BG + (255,) if part == "c" else (30, 30, 58, 255)
        Image.new("RGBA", (6, 6), colour).save(f"{gdir}/terminal_box_{part}.png")

# Boot splash (Plymouth): our mark replaces the distributor logo fallback
# and a PRIMERS wordmark replaces the Ubuntu watermark.
pdir = "/usr/share/plymouth/themes/primers"
if os.path.isdir(pdir):
    mark(128, glow=False).save(f"{pdir}/bgrt-fallback.png")
    wm = Image.new("RGBA", (320, 48), (0, 0, 0, 0))
    dw = ImageDraw.Draw(wm)
    f = font(30, bold=True)
    tw = dw.textlength("PRIMERS OS", font=f)
    dw.text(((320 - tw) / 2, 4), "PRIMERS OS", font=f, fill=TEXT + (255,))
    wm.save(f"{pdir}/watermark.png")

# Calamares branding images
brand = "/etc/calamares/branding/primers"
if os.path.isdir(brand):
    mark(128).save(f"{brand}/logo.png")
    mark(64).save(f"{brand}/icon.png")
    welcome = Image.new("RGBA", (640, 300), BG + (255,))
    m = mark(200)
    welcome.paste(m, (40, 50), m)
    dw = ImageDraw.Draw(welcome)
    dw.text((270, 105), "PRIMERS OS", font=font(46, bold=True), fill=TEXT)
    dw.text((272, 170), "1.0 Genesis", font=font(24), fill=ACCENT)
    welcome.save(f"{brand}/welcome.png")
print("[PRIMERS] artwork generated")
PYEOF

gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true

update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
  /usr/share/plymouth/themes/primers/primers.plymouth 200
update-alternatives --set default.plymouth /usr/share/plymouth/themes/primers/primers.plymouth

# ── GRUB theme fonts (installed system + live ISO menu) ─────
THEME=/usr/share/grub/themes/primers
NOTO=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf
if [ -f "$THEME/theme.txt" ] && [ -f "$NOTO" ]; then
  for size in 11 14 20; do
    grub-mkfont -s "$size" -o "$THEME/noto-sans-$size.pf2" "$NOTO"
  done
fi

# ── Display manager ─────────────────────────────────────────
# Live-session autologin is configured by casper at boot; installed systems
# follow the choice made in the installer.
install -d /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-primers.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=openbox
greeter-setup-script=/usr/bin/numlockx on
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'EOF'
[greeter]
background=/usr/share/primers/wallpaper.png
theme-name=Adwaita-dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 11
indicators=~host;~spacer;~clock;~spacer;~session;~power
clock-format=%H:%M  %A %d %B
default-user-image=/usr/share/primers/logo.png
EOF

# ── GTK defaults for every new user ─────────────────────────
install -d /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=1
EOF
cat > /etc/skel/.gtkrc-2.0 <<'EOF'
gtk-theme-name="Adwaita-dark"
gtk-icon-theme-name="Papirus-Dark"
gtk-font-name="Noto Sans 10"
EOF

# Make sure skel helpers are executable
chmod 0755 /etc/skel/.config/openbox/autostart 2>/dev/null || true
