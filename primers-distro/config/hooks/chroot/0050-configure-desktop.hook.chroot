#!/bin/bash
# PRIMERS OS — desktop look & feel, artwork, display manager
#
# Artwork comes from the official logo pack (branding/primers-os-logo,
# installed to /usr/share/primers/branding by build.sh). Brand rules: Night
# Ink #12161C, Chalk #F5F2EA, Ready Green #1E9E62 for the cursor and states
# only; never stretch, add shadows or gradients, recolour or move the cursor,
# or retype the wordmark.
set -euo pipefail

BRAND=/usr/share/primers/branding
[ -f "$BRAND/png/mark-color.png" ] || { echo "[PRIMERS] brand assets missing in $BRAND" >&2; exit 1; }
install -d /usr/share/primers /usr/share/pixmaps

# ── Plymouth boot splash: the mark with its blinking cursor ──
PLY=/usr/share/plymouth/themes/primers
rm -rf "$PLY"
install -d "$PLY"
# Generic password/entry graphics from the spinner theme; boot frames are ours
for f in bullet capslock entry keyboard keymap-render lock; do
  [ -f "/usr/share/plymouth/themes/spinner/$f.png" ] && cp "/usr/share/plymouth/themes/spinner/$f.png" "$PLY/"
done
cat > "$PLY/primers.plymouth" <<'PLYEOF'
[Plymouth Theme]
Name=PRIMERS OS
Description=PRIMERS OS boot splash: the Primers mark with its blinking cursor
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/primers
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.75
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.94
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x12161c
BackgroundEndColor=0x12161c
ProgressBarBackgroundColor=0x262c35
ProgressBarForegroundColor=0x1e9e62
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates…
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading PRIMERS OS…
SubTitle=Do not turn off your computer
PLYEOF

# Reduced motion (primers-reduce-motion): the same splash, cursor still
STILL=/usr/share/plymouth/themes/primers-still
rm -rf "$STILL"
install -d "$STILL"
cp "$PLY"/*.png "$STILL/" 2>/dev/null || true
sed -e 's|^Name=.*|Name=PRIMERS OS (reduced motion)|' \
    -e 's|^Description=.*|Description=PRIMERS OS boot splash with the cursor still (reduced motion)|' \
    -e "s|^ImageDir=.*|ImageDir=$STILL|" "$PLY/primers.plymouth" > "$STILL/primers-still.plymouth"

# ── Artwork from the official logo pack ─────────────────────
python3 - <<'PYEOF'
import os
import shutil
from PIL import Image

BRAND = "/usr/share/primers/branding/png"
INK = (18, 22, 28)
CHALK = (245, 242, 234)
GREEN = (30, 158, 98)


def load(name):
    return Image.open(os.path.join(BRAND, name)).convert("RGBA")


def without_cursor(img):
    """The 'cursor off' blink frame: the official artwork with its cursor
    gone. The cursor sits on the artwork's own Night Ink, so its pixels
    (and their antialiased edge) become Night Ink; nothing else changes."""
    out = img.copy()
    px = out.load()
    for y in range(out.height):
        for x in range(out.width):
            r, g, b, a = px[x, y]
            if a and g > r + 25 and g > b + 15:
                px[x, y] = INK + (a,)
    return out


def fit(img, width):
    h = round(img.height * width / img.width)  # always keep the aspect ratio
    return img.resize((width, h), Image.LANCZOS)


def place(canvas, img, cx, top):
    canvas.alpha_composite(img, (int(cx - img.width / 2), int(top)))


# Official artwork for dark backgrounds, used as it is (never redrawn or
# recoloured): the app icon is the Chalk P with the green cursor on Night
# Ink, and the dark lockup is the mark and wordmark on Night Ink. On a Night
# Ink background their own Night Ink disappears.
icon = load("app-icon-1024.png")
lockup = load("lockup-horizontal-dark.png")

# Desktop wallpaper: Night Ink with the lockup in the middle
for w, h, name in ((1920, 1080, "wallpaper.png"),):
    wp = Image.new("RGBA", (w, h), INK + (255,))
    logo = fit(lockup, int(w * 0.36))
    place(wp, logo, w / 2, (h - logo.height) / 2)
    wp.convert("RGB").save(f"/usr/share/primers/{name}", optimize=True)

# Login screen: the lockup above the sign-in box (which sits in the middle)
ln = Image.new("RGBA", (1920, 1080), INK + (255,))
place(ln, fit(lockup, 560), 960, 130)
ln.convert("RGB").save("/usr/share/primers/login.png", optimize=True)

# Icons: the official app icons, unmodified
sizes = {16: "app-icon-16.png", 32: "app-icon-32.png", 48: "app-icon-48.png",
         64: "app-icon-64.png", 128: "app-icon-128.png", 256: "app-icon-256.png",
         512: "app-icon-512.png"}
for px, fname in sizes.items():
    d = f"/usr/share/icons/hicolor/{px}x{px}/apps"
    os.makedirs(d, exist_ok=True)
    shutil.copy(os.path.join(BRAND, fname), f"{d}/primers.png")
shutil.copy(os.path.join(BRAND, "app-icon-64.png"), "/usr/share/pixmaps/primers.png")


def write_xpm(src, path, name):
    """The same icon as XPM (xterm reads only XPM for its window icon):
    every pixel kept, colours as they are, transparent stays transparent."""
    img = load(src)
    chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*+-./:;<=>?@[]^_`{|}~"
    pixels = [(r, g, b) if a >= 128 else None for r, g, b, a in img.getdata()]
    colours = sorted({p for p in pixels if p}, key=lambda c: (c[0], c[1], c[2]))
    if len(colours) + 1 > len(chars) ** 2:
        raise SystemExit("icon has too many colours for XPM")
    code = {None: "  "}
    for i, c in enumerate(colours):
        code[c] = chars[i // len(chars)] + chars[i % len(chars)]
    w, h = img.size
    rows = ['"' + "".join(code[pixels[y * w + x]] for x in range(w)) + '"' for y in range(h)]
    header = [f'"{w} {h} {len(colours) + 1} 2"', '"   c None"'] + \
             [f'"{code[c]} c #{c[0]:02X}{c[1]:02X}{c[2]:02X}"' for c in colours]
    with open(path, "w") as f:
        f.write(f"/* XPM */\nstatic char *{name}[] = {{\n" + ",\n".join(header + rows) + "\n};\n")


write_xpm("app-icon-48.png", "/usr/share/pixmaps/primers_48x48.xpm", "primers_48x48")
shutil.copy(os.path.join(BRAND, "app-icon-256.png"), "/usr/share/primers/logo.png")

# GRUB menu background: the lockup at the top, the menu below
gdir = "/usr/share/grub/themes/primers"
if os.path.isdir(gdir):
    gb = Image.new("RGBA", (1280, 800), INK + (255,))
    place(gb, fit(lockup, 520), 640, 80)
    gb.convert("RGB").save(f"{gdir}/background.png", optimize=True)
    for part in ("c", "n", "s", "e", "w", "ne", "nw", "se", "sw"):
        colour = INK + (255,) if part == "c" else (38, 44, 53, 255)
        Image.new("RGBA", (6, 6), colour).save(f"{gdir}/terminal_box_{part}.png")

# Plymouth: the white P on Night Ink, its green cursor blinking in steps:
# 32 frames = 1.06 s at Plymouth's 30 frames a second, 16 with the cursor
# and 16 without. The 'still' theme (reduced motion) keeps the cursor on.
on = fit(icon, 128)
off = fit(without_cursor(icon), 128)
for theme, frames in (("primers", [on] * 16 + [off] * 16), ("primers-still", [on] * 32)):
    pdir = f"/usr/share/plymouth/themes/{theme}"
    if not os.path.isdir(pdir):
        continue
    for i, frame in enumerate(frames, 1):
        frame.save(f"{pdir}/throbber-{i:04d}.png")
    on.save(f"{pdir}/animation-0001.png")
    Image.new("RGBA", (1, 1), (0, 0, 0, 0)).save(f"{pdir}/bgrt-fallback.png")
    Image.new("RGBA", (1, 1), (0, 0, 0, 0)).save(f"{pdir}/watermark.png")

# Installer branding
brand = "/etc/calamares/branding/primers"
if os.path.isdir(brand):
    shutil.copy(os.path.join(BRAND, "app-icon-128.png"), f"{brand}/logo.png")
    shutil.copy(os.path.join(BRAND, "app-icon-64.png"), f"{brand}/icon.png")
    welcome = load("lockup-horizontal-dark.png")
    fit(welcome, 640).save(f"{brand}/welcome.png")
    fit(icon, 96).save(f"{brand}/mark-dark.png")      # the official app icon (P on Night Ink)
print("[PRIMERS] artwork generated from the official logo pack")
PYEOF

gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true

update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
  /usr/share/plymouth/themes/primers/primers.plymouth 200
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
  /usr/share/plymouth/themes/primers-still/primers-still.plymouth 150
update-alternatives --set default.plymouth /usr/share/plymouth/themes/primers/primers.plymouth

# ── GRUB theme fonts (installed system + live ISO menu) ─────
THEME=/usr/share/grub/themes/primers
NOTO=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf
if [ -f "$THEME/theme.txt" ] && [ -f "$NOTO" ]; then
  for size in 11 14 20; do
    grub-mkfont -s "$size" -o "$THEME/noto-sans-$size.pf2" "$NOTO"
  done
fi

# ── Display manager ─────────────────────────────────────────
# Live-session autologin is configured by casper at boot; installed systems
# follow the choice made in the installer.
install -d /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-primers.conf <<'EOF'
[Seat:*]
greeter-session=lightdm-gtk-greeter
user-session=openbox
greeter-setup-script=/usr/bin/numlockx on
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'EOF'
[greeter]
background=/usr/share/primers/login.png
theme-name=Adwaita-dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 11
indicators=~host;~spacer;~clock;~spacer;~session;~power
clock-format=%H:%M  %A %d %B
default-user-image=/usr/share/primers/logo.png
EOF

# ── GTK defaults for every new user ─────────────────────────
install -d /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=Adwaita-dark
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=1
EOF
cat > /etc/skel/.gtkrc-2.0 <<'EOF'
gtk-theme-name="Adwaita-dark"
gtk-icon-theme-name="Papirus-Dark"
gtk-font-name="Noto Sans 10"
EOF

# Make sure skel helpers are executable
chmod 0755 /etc/skel/.config/openbox/autostart 2>/dev/null || true
