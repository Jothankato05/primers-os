#!/bin/bash
# PRIMERS OS — PRIMERS brain checks
# build.sh copies the brain to /usr/share/primers/brain; this hook
# precompiles it and refuses to ship an image where it cannot start.
set -euo pipefail

BRAIN=/usr/share/primers/brain
[ -f "$BRAIN/main.py" ] || { echo "[PRIMERS] brain missing at $BRAIN" >&2; exit 1; }

chmod 0755 /usr/bin/primers /usr/bin/primers-install /usr/bin/primers-compat

# Byte-compile with the image's own Python (catches syntax errors for 3.10)
python3 -m compileall -q "$BRAIN"

# Smoke test: the brain must boot and answer a command non-interactively
HOME=/tmp/primers-smoke PRIMERS_DATA_DIR=/tmp/primers-smoke \
  python3 "$BRAIN/main.py" --version
HOME=/tmp/primers-smoke PRIMERS_DATA_DIR=/tmp/primers-smoke \
  python3 "$BRAIN/main.py" -c "math 2^10" | grep -q "1,024"
rm -rf /tmp/primers-smoke
echo "[PRIMERS] brain smoke test passed"
