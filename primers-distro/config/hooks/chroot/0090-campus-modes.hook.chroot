#!/bin/bash
# PRIMERS OS — campus modes: Lab Mode, Study Mode and Exam Mode
#
# Lab Mode is OFF in the image. On each lab machine an administrator runs
# "sudo primers-lab enable": that creates a passwordless, non-admin "lab"
# account and wipes it at every sign-in, sign-out and boot. Here we only
# check that the pieces it relies on are in place.
set -euo pipefail

# LightDM lets members of nopasswdlogin sign in without a password
getent group nopasswdlogin >/dev/null || groupadd --system nopasswdlogin
if ! grep -Eq '^auth[[:space:]]+sufficient[[:space:]]+pam_succeed_if\.so user ingroup nopasswdlogin' /etc/pam.d/lightdm; then
  echo "E: /etc/pam.d/lightdm has no nopasswdlogin rule; Lab Mode sign-in would ask for a password" >&2
  exit 1
fi

# Never shipped switched on
systemctl disable primers-lab-reset.service >/dev/null 2>&1 || true
rm -f /etc/primers/lab.conf /etc/lightdm/lightdm.conf.d/60-primers-lab.conf
chmod 0755 /usr/bin/primers-lab
command -v zenity >/dev/null

out=$(primers-lab status)
grep -q "Lab Mode: off" <<<"$out" || { echo "E: primers-lab status: $out" >&2; exit 1; }
echo "Lab Mode: available (off by default)"

# Study Mode: per-user focus timer (Brain "study", primers-study, panel timer)
chmod 0755 /usr/bin/primers-study /usr/lib/primers/study-panel
out=$(HOME=/nonexistent XDG_STATE_HOME=/nonexistent primers-study status)
grep -q "Study Mode: off" <<<"$out" || { echo "E: primers-study status: $out" >&2; exit 1; }
HOME=/nonexistent /usr/lib/primers/study-panel
echo "Study Mode: available"

# Exam Mode: kiosk session, firewall tool, nothing but Openbox at the login
# screen (any other session would bypass the exam kiosk)
chmod 0755 /usr/bin/primers-exam /usr/lib/primers/exam-session
command -v nft >/dev/null || { echo "E: nft (nftables) missing" >&2; exit 1; }
sh -n /etc/X11/Xsession.d/98primers-exam
others=$(find /usr/share/xsessions /usr/share/wayland-sessions -name '*.desktop' ! -name openbox.desktop 2>/dev/null || true)
if [ -n "$others" ]; then
  echo "E: login sessions besides Openbox would bypass Exam Mode:" $others >&2
  exit 1
fi
rm -f /etc/primers/exam.conf /etc/polkit-1/localauthority/90-mandatory.d/60-primers-exam.pkla \
      /etc/X11/xorg.conf.d/90-primers-exam.conf /etc/sysctl.d/90-primers-exam.conf \
      /etc/grub.d/09_primers_exam /etc/default/grub.d/90-primers-exam.cfg
install -d /etc/X11/xorg.conf.d /etc/default/grub.d
# Exam Mode across power cuts (ADR 0004): the durable exam log, readable by
# root and the adm group like the journal, and the service that copies the
# candidate's events into it while an exam is on
install -d -m 2750 -o root -g adm /var/log/primers
systemctl enable primers-exam-log.service
# Exam servers that change address during an exam (CDNs) are followed
systemctl enable primers-exam-refresh.timer
# During an exam the exam firewall is in place before any network interface
# comes up (NetworkManager starts after network-pre.target), so the login
# screen needn't wait for the network (hook 0060)
systemctl enable primers-exam-firewall.service
grep -qx 'Before=network-pre.target shutdown.target' /etc/systemd/system/primers-exam-firewall.service \
  && grep -qx 'Wants=network-pre.target' /etc/systemd/system/primers-exam-firewall.service \
  && grep -qx 'After=network-pre.target dbus.service' /lib/systemd/system/NetworkManager.service \
  || { echo "E: the exam firewall must come before the network: check primers-exam-firewall.service and NetworkManager.service" >&2; exit 1; }
# During an exam, the exam browser is read into memory after boot (benchmarks)
chmod 0755 /usr/lib/primers/exam-prewarm
systemctl enable primers-exam-prewarm.service
# primers-fleet (ADR 0006): the agent runs only once the PC is paired with an
# invigilator PC (its unit's condition); its keys are root's alone
systemctl enable primers-fleet-agent.service
grep -q '^ConditionDirectoryNotEmpty=/etc/primers/fleet/controllers$' /etc/systemd/system/primers-fleet-agent.service \
  || { echo "E: primers-fleet-agent must only run on a paired PC" >&2; exit 1; }
python3 -c 'import cryptography.x509, ssl; assert ssl.HAS_TLSv1_3' \
  || { echo "E: primers-fleet needs python3-cryptography and TLS 1.3" >&2; exit 1; }
# The boot menu lock re-emits 10_linux's first entry: it must still look
# the way the lock expects (an entry with --class options)
grep -q '^CLASS="--class gnu-linux --class gnu --class os"$' /etc/grub.d/10_linux \
  || { echo "E: /etc/grub.d/10_linux changed; check the exam boot menu lock" >&2; exit 1; }
command -v update-grub >/dev/null || { echo "E: update-grub missing (exam boot menu lock)" >&2; exit 1; }
# The lab account's shell during an exam refuses to run anything; it is a
# registered shell so the account stays on the login screen's user list
chmod 0755 /usr/lib/primers/exam-shell
grep -qx /usr/lib/primers/exam-shell /etc/shells || echo /usr/lib/primers/exam-shell >> /etc/shells
command -v xsel setxkbmap >/dev/null || { echo "E: xsel/setxkbmap missing (exam clipboard and key lock)" >&2; exit 1; }

# The installer's sfdisk correction (Calamares 3.2.61 GPT end-of-disk bug),
# switched on in the live session only
chmod 0755 /usr/lib/primers/installer/sfdisk
systemctl enable primers-installer-fixes.service
grep -q '^ConditionKernelCommandLine=boot=casper$' /etc/systemd/system/primers-installer-fixes.service \
  || { echo "E: the installer fix must be limited to the live session" >&2; exit 1; }

# The guest agent (for automated VM tests) must only ever start inside a VM
if ! grep -q 'BindsTo=dev-virtio\\x2dports-org.qemu.guest_agent.0.device' \
     /lib/systemd/system/qemu-guest-agent.service; then
  echo "E: qemu-guest-agent is not bound to the VM's virtio channel" >&2
  exit 1
fi
out=$(primers-exam status)
grep -q "Exam Mode: off" <<<"$out" || { echo "E: primers-exam status: $out" >&2; exit 1; }
echo "Exam Mode: available (no exam running)"
