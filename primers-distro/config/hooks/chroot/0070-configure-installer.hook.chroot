#!/bin/bash
# PRIMERS OS - installer (Calamares) integration for the live session
# Calamares configuration lives in /etc/calamares (copied by build.sh).
set -euo pipefail

[ -f /etc/calamares/settings.conf ] || { echo "[PRIMERS] /etc/calamares missing" >&2; exit 1; }

# Launcher; removed from the installed system by the installer itself
cat > /usr/share/applications/install-primers.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Install PRIMERS OS
Comment=Install PRIMERS OS to this computer
Exec=sudo -E calamares
Icon=primers
Terminal=false
Categories=System;
EOF

install -d /etc/skel/Desktop
cp /usr/share/applications/install-primers.desktop /etc/skel/Desktop/install-primers.desktop
chmod 0755 /etc/skel/Desktop/install-primers.desktop
