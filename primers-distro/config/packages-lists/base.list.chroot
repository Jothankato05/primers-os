xarchiver
galculator
lxtask
numlockx
zenity
notification-daemon
papirus-icon-theme
gnome-themes-extra
plymouth
plymouth-theme-spinner

# ── Audio ───────────────────────────────────────────────────
pulseaudio
pavucontrol
pasystray
alsa-utils

# ── Fonts ───────────────────────────────────────────────────
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji
fonts-liberation

# ── PRIMERS brain runtime ───────────────────────────────────
python3
