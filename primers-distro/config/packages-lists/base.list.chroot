# PRIMERS OS — base system (Ubuntu 22.04 "jammy" package names)
# One package per line; '#' starts a comment. ':i386' selects 32-bit.
# The kernel and casper are installed by build.sh (see KERNEL_PACKAGE).

# ── Core system ─────────────────────────────────────────────
ubuntu-minimal
systemd-sysv
sudo
locales
tzdata
dbus-x11
policykit-1
apparmor
unattended-upgrades
ufw
nftables
zram-tools
laptop-detect
rsync

# ── Hardware support ────────────────────────────────────────
linux-firmware
intel-microcode
amd64-microcode
bluez
blueman

# ── Bootloaders (used by the installer on BIOS and UEFI) ────
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64
grub-efi-amd64-signed
shim-signed
efibootmgr
os-prober

# ── Installer ───────────────────────────────────────────────
calamares
qml-module-qtquick2
qml-module-qtquick-controls2
qml-module-qtquick-window2
qml-module-qtquick-layouts
dosfstools
ntfs-3g
parted
cryptsetup
cryptsetup-initramfs

# ── Networking ──────────────────────────────────────────────
network-manager
network-manager-gnome
wpasupplicant
openssh-client
iputils-ping
curl
wget

# ── Graphical desktop (LightDM + Openbox + tint2) ───────────
xserver-xorg
xserver-xorg-video-all
xserver-xorg-input-all
x11-xserver-utils
xinit
lightdm
lightdm-gtk-greeter
openbox
obconf
tint2
