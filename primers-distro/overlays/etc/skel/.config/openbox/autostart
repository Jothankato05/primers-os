# PRIMERS OS session autostart (Openbox)
# Standard folders (Documents, Downloads, Music...). Openbox can't run
# /etc/xdg/autostart (it needs PyXDG), which keeps GNOME daemons out.
xdg-user-dirs-update
tint2 &
pcmanfm --desktop &
nm-applet &
blueman-applet &
pasystray &
lxpolkit &
numlockx on &
(sleep 2 && primers-terminal) &
# Lab Mode: remind students that the shared lab account is wiped at sign-out
# (with the privacy notice's short version); then, on other accounts, the
# privacy notice the first time (and when it changes)
(sleep 3; [ -f /etc/primers/lab.conf ] && primers-lab notice; primers-privacy notice --first-run) &
