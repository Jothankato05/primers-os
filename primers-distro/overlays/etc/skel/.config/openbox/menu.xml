<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="apps-menu" label="Applications">
    <item label="Primers Lite Bee (browser)"><action name="Execute"><command>lite-bee</command></action></item>
    <item label="Firefox"><action name="Execute"><command>firefox</command></action></item>
    <item label="File Manager"><action name="Execute"><command>pcmanfm</command></action></item>
    <item label="Text Editor"><action name="Execute"><command>mousepad</command></action></item>
    <item label="Image Viewer"><action name="Execute"><command>gpicview</command></action></item>
    <item label="Archive Manager"><action name="Execute"><command>xarchiver</command></action></item>
    <item label="Calculator"><action name="Execute"><command>galculator</command></action></item>
    <item label="Media Player (VLC)"><action name="Execute"><command>vlc</command></action></item>
    <item label="Screen Recorder (OBS)"><action name="Execute"><command>obs</command></action></item>
    <item label="Games (Lutris)"><action name="Execute"><command>lutris</command></action></item>
  </menu>
  <menu id="system-menu" label="System">
    <item label="Task Manager"><action name="Execute"><command>lxtask</command></action></item>
    <item label="Sound Settings"><action name="Execute"><command>pavucontrol</command></action></item>
    <item label="Bluetooth"><action name="Execute"><command>blueman-manager</command></action></item>
    <item label="Network Connections"><action name="Execute"><command>nm-connection-editor</command></action></item>
    <item label="Appearance"><action name="Execute"><command>lxappearance</command></action></item>
    <item label="Window Manager Settings"><action name="Execute"><command>obconf</command></action></item>
    <item label="Wine Configuration"><action name="Execute"><command>primers-compat --winecfg</command></action></item>
  </menu>
  <menu id="root-menu" label="PRIMERS OS">
    <item label="⚛ PRIMERS Brain"><action name="Execute"><command>primers-terminal</command></action></item>
    <item label="Terminal"><action name="Execute"><command>xterm -fa Monospace -fs 11 -bg "#12161C" -fg "#F5F2EA"</command></action></item>
    <item label="Primers Lite Bee"><action name="Execute"><command>lite-bee</command></action></item>
    <item label="File Manager"><action name="Execute"><command>pcmanfm</command></action></item>
    <separator/>
    <menu id="apps-menu"/>
    <menu id="system-menu"/>
    <separator/>
    <item label="Install Software Module…"><action name="Execute"><command>xterm -fa Monospace -fs 11 -bg "#12161C" -fg "#F5F2EA" -e bash -c "primers-install; echo; read -r -p 'Module to install (blank to close): ' m; [ -n \"$m\" ] &amp;&amp; primers-install \"$m\"; read -r -p 'Press Enter to close'"</command></action></item>
    <item label="Open Dashboard"><action name="Execute"><command>primers-terminal --gui</command></action></item>
    <separator/>
    <item label="Log Out"><action name="Exit"><prompt>yes</prompt></action></item>
    <item label="Restart"><action name="Execute"><command>systemctl reboot</command></action></item>
    <item label="Shut Down"><action name="Execute"><command>systemctl poweroff</command></action></item>
  </menu>
</openbox_menu>
