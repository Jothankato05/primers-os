<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="PRIMERS OS">
    <item label="⚛ PRIMERS Brain">
      <action name="Execute">
        <command>xterm -title "PRIMERS OS" -geometry 120x35 -bg "#0a0a0f" -fg "#c8c8e8" -e primers</command>
      </action>
    </item>
    <item label="File Manager">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="Web Browser">
      <action name="Execute"><command>firefox</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <command>xterm -bg "#0a0a0f" -fg "#c8c8e8"</command>
      </action>
    </item>
    <separator/>
    <item label="Install Software Module">
      <action name="Execute">
        <command>xterm -bg "#0a0a0f" -fg "#c8c8e8" -e bash -c "primers-install; echo; echo 'Press Enter to close'; read"</command>
      </action>
    </item>
    <item label="Run Windows App (.exe)">
      <action name="Execute">
        <command>xterm -bg "#0a0a0f" -fg "#c8c8e8" -e bash -c "echo 'Enter path to .exe file:'; read f; primers-compat \"$f\"; read"</command>
      </action>
    </item>
    <item label="Open Dashboard (browser)">
      <action name="Execute"><command>firefox http://localhost:5000</command></action>
    </item>
    <separator/>
    <item label="System Settings">
      <action name="Execute"><command>obconf</command></action>
    </item>
    <separator/>
    <item label="Logout">
      <action name="Exit"/>
    </item>
    <item label="Shutdown">
      <action name="Execute"><command>systemctl poweroff</command></action>
    </item>
    <item label="Restart">
      <action name="Execute"><command>systemctl reboot</command></action>
    </item>
  </menu>
</openbox_menu>
