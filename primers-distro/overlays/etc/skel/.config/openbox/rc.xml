<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <font place="ActiveWindow">
      <name>Noto Sans</name><size>9</size><weight>Normal</weight>
    </font>
  </theme>
  <desktops><number>4</number></desktops>
  <keyboard>
    <keybind key="Super-Return">
      <action name="Execute">
        <command>primers-terminal</command>
      </action>
    </keybind>
    <keybind key="Super-e">
      <action name="Execute"><command>pcmanfm</command></action>
    </keybind>
    <keybind key="Super-b">
      <action name="Execute"><command>lite-bee</command></action>
    </keybind>
    <keybind key="Super-t">
      <action name="Execute"><command>xterm -fa Monospace -fs 11 -bg "#0a0a0f" -fg "#c8c8e8"</command></action>
    </keybind>
    <keybind key="Super-space">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute"><command>lxtask</command></action>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"><command>pactl set-sink-volume @DEFAULT_SINK@ +5%</command></action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"><command>pactl set-sink-volume @DEFAULT_SINK@ -5%</command></action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute"><command>pactl set-sink-mute @DEFAULT_SINK@ toggle</command></action>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="Super-d">
      <action name="ToggleShowDesktop"/>
    </keybind>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
    <context name="Desktop">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <file>menu.xml</file>
    <hideDelay>200</hideDelay>
    <submenuShowDelay>100</submenuShowDelay>
  </menu>
</openbox_config>
