#!/bin/sh
# PRIMERS OS panel: minutes left in the current Study Mode session (or nothing).
f="${XDG_STATE_HOME:-$HOME/.local/state}/primers/study"
[ -r "$f" ] || exit 0
until=$(sed -n 's/^until=\([0-9][0-9]*\)$/\1/p' "$f")
[ -n "$until" ] || exit 0
left=$((until - $(date +%s)))
[ "$left" -gt 0 ] || exit 0
echo "Study $(((left + 59) / 60)) min"
