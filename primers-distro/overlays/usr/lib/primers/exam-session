#!/bin/sh
# PRIMERS OS Exam Mode session for the shared lab account: a window manager
# with nothing to click or press, and Primers Lite Bee showing only the exam.
#
# The session ends when the candidate presses "Finish exam", when the exam
# is stopped, or when the exam browser stops for any other reason (crash,
# killed): it is never restarted and nothing else is ever started, so there
# is no way through to a desktop. Lab Mode then wipes the account.
conf=/etc/primers/exam.conf
me=$(id -un)
clear_clipboards() { xsel --clipboard --clear 2>/dev/null; xsel --primary --clear 2>/dev/null; }

# No Ctrl+Alt+F1..F12 or Ctrl+Alt+Backspace in this session, whatever the
# display server was started with (the console lock in xorg.conf.d covers
# the login screen; this covers a display started before the exam).
setxkbmap -option srvrkeys:none 2>/dev/null
xset s off -dpms 2>/dev/null           # no screen blanking during the exam
clear_clipboards

openbox --config-file /usr/share/primers/exam/openbox.xml &
wm=$!
logger -t primers-exam "exam session started ($me)"

if [ -r "$conf" ]; then
  lite-bee --kiosk
  status=$?
else
  status=4
fi
case $status in
  3) logger -t primers-exam "exam finished by the candidate ($me)" ;;
  4) logger -t primers-exam "exam closed: the exam was stopped ($me)" ;;
  *) logger -t primers-exam "exam browser stopped unexpectedly (status $status); ending the session ($me)" ;;
esac

clear_clipboards
kill "$wm" 2>/dev/null
logger -t primers-exam "exam session ended ($me)"
