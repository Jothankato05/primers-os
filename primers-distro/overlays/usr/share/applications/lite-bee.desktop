[Desktop Entry]
Type=Application
Name=Primers Lite Bee
GenericName=Web Browser
Comment=Fast, data-saving web browser for 2G, LTE and Wi-Fi
Exec=lite-bee %U
Icon=lite-bee
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=browser;web;internet;data;saver;2g;
StartupNotify=true
StartupWMClass=lite-bee
Actions=ultra;

[Desktop Action ultra]
Name=Open in Ultra data-saving mode
Exec=lite-bee --mode ultra
