# PRIMERS OS window frames: Night Ink #12161C, Chalk #F5F2EA, Ready Green
# #1E9E62 (for states only: the focused window's border).
border.width: 1
padding.width: 6
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: #1E9E62
window.inactive.border.color: #262C35
window.active.title.bg: flat solid
window.active.title.bg.color: #12161C
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1A1F27
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #F5F2EA
window.inactive.label.text.color: #8A8F98
window.label.text.justify: left
window.active.handle.bg: flat solid
window.active.handle.bg.color: #12161C
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #1A1F27
window.active.grip.bg: flat solid
window.active.grip.bg.color: #12161C
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #1A1F27

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #F5F2EA
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #262C35
window.active.button.hover.image.color: #F5F2EA
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #1E9E62
window.active.button.pressed.image.color: #12161C
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4A505A
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #1E9E62
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #8A8F98
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #262C35
window.inactive.button.hover.image.color: #F5F2EA
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #1E9E62
window.inactive.button.pressed.image.color: #12161C
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #4A505A
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #8A8F98

menu.border.width: 1
menu.border.color: #262C35
menu.title.bg: flat solid
menu.title.bg.color: #12161C
menu.title.text.color: #F5F2EA
menu.items.bg: flat solid
menu.items.bg.color: #1A1F27
menu.items.text.color: #F5F2EA
menu.items.disabled.text.color: #4A505A
menu.items.active.bg: flat solid
menu.items.active.bg.color: #262C35
menu.items.active.text.color: #F5F2EA
menu.separator.color: #262C35
menu.separator.width: 1

osd.border.width: 1
osd.border.color: #262C35
osd.bg: flat solid
osd.bg.color: #12161C
osd.label.text.color: #F5F2EA
osd.hilight.bg: flat solid
osd.hilight.bg.color: #1E9E62
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #262C35
