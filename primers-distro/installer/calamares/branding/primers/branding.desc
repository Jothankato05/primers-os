---
# PRIMERS OS — Calamares branding (images are generated at build time by
# config/hooks/chroot/0050-configure-desktop.hook.chroot)
componentName: primers

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px,640px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
  productName:         "PRIMERS OS"
  shortProductName:    "PRIMERS"
  version:             "1.0 Genesis"
  shortVersion:        "1.0"
  versionedName:       "PRIMERS OS 1.0 Genesis"
  shortVersionedName:  "PRIMERS 1.0"
  bootloaderEntryName: "PRIMERS OS"
  productUrl:          "https://primeros.org"
  supportUrl:          "https://github.com/Jothankato05/primers-os/issues"
  knownIssuesUrl:      "https://github.com/Jothankato05/primers-os/issues"
  releaseNotesUrl:     "https://github.com/Jothankato05/primers-os/releases"

images:
  productLogo:    "logo.png"
  productIcon:    "icon.png"
  productWelcome: "welcome.png"

slideshow:    "show.qml"
slideshowAPI: 2

# Calamares 3.2.x reads these names (current-step colours use *Select*)
style:
  SidebarBackground:         "#0a0a0f"
  SidebarText:               "#c8c8e8"
  SidebarTextSelect:         "#0a0a0f"
  SidebarTextSelected:       "#0a0a0f"
  SidebarBackgroundSelected: "#00e5ff"
  SidebarTextHighlight:      "#00e5ff"
  sidebarBackground:         "#0a0a0f"
  sidebarText:               "#c8c8e8"
  sidebarTextSelect:         "#0a0a0f"
  sidebarTextHighlight:      "#00e5ff"
